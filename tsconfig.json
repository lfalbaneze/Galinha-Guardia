{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "rootDir": "src",
    "outDir": ".",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
