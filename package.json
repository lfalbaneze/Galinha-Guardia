{
  "name": "galinha-guardia",
  "private": true,
  "version": "1.1.0",
  "description": "Penas pro Ar! Uma aventura na fazenda em TypeScript e Canvas 2D.",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "check:generated": "node scripts/check-generated.cjs",
    "dev": "tsc -p tsconfig.json --watch",
    "build": "node scripts/build.cjs",
    "pretest": "npm run compile",
    "test": "node scripts/test.cjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "sprites:build": "node scripts/build-sprite-data.cjs && node scripts/render-wardrobe.cjs",
    "sprites:review": "node scripts/render-sprite-review.cjs && node scripts/render-characters.cjs",
    "sprites:pixellab": "node scripts/pixellab.cjs",
    "sprites:pixellab:build": "node scripts/build-pixellab-art.cjs",
    "preview:render": "node scripts/render-preview.cjs",
    "audio:generate": "node scripts/generate-audio.cjs",
    "audio:preview": "node scripts/render-audio-preview.cjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Luis Albaneze"
}
